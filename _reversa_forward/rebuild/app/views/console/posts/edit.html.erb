<%# console.post / console.post-new — the block editor (target_screens.md § The editor).
    DEV-015: this mounts the REAL WordPress editor (@wordpress/edit-post's own
    initializeEditor, called as wp-admin calls it), not a reimplementation. The server names
    the record and hands over the nonce; everything visible is upstream Gutenberg talking to
    this rebuild's own wp/v2 API. The <noscript> block keeps the raw-markup form, which saves
    through the identical Publishing::Post commands when JavaScript is off. -%>
<% @editor_island = true %>
<% @island_asset = "gutenberg" %>

<%# Server-side notices (a revision restore, a failed save from the noscript form) still have
    to reach the reader: Gutenberg owns the canvas, not the page, and it knows nothing about
    Rails' flash. Rendered above the mount so it is visible with or without JavaScript. -%>
<% if flash[:notice].present? || flash[:success].present? || flash[:error].present? %>
  <div class="notice <%= flash[:error].present? ? "notice-error" : "notice-success" %>">
    <p><%= flash[:error].presence || flash[:success].presence || flash[:notice] %></p>
  </div>
<% end %>

<div id="gutenberg-root"
     data-post-id="<%= @post.id %>"
     data-post-type="<%= @post.is_a?(Publishing::Page) ? "page" : "post" %>"
     data-settings="<%= editor_settings_json %>"></div>

<noscript>
  <div id="editor-fallback">
    <%= form_with url: console_post_path(@post), method: :patch do |f| %>
      <div class="edit-bar">
        <span class="title"><%= @title %></span>
        <%= f.submit "Save Draft", name: "command", value: "draft", class: "button" %>
        <% unless @post.published? %>
          <%= f.submit "Publish", name: "command", value: "publish", class: "button button-primary" %>
        <% end %>
        <% if @post.published? %>
          <%= f.submit "Update", name: "command", value: "draft", class: "button button-primary" %>
        <% end %>
      </div>
      <main class="canvas">
        <p class="placeholder-note">The block editor needs JavaScript. The post's raw block
        markup is editable below and saves through the identical command path.</p>
        <div class="doc">
          <%= f.text_field :title, value: @post.title, class: "title-input",
                           placeholder: "Add title", "aria-label": "Add title" %>
          <%= f.text_area :content, value: @post.content, class: "block-canvas",
                          placeholder: "Type / to choose a block", spellcheck: false %>
        </div>
      </main>
    <% end %>
  </div>
</noscript>
