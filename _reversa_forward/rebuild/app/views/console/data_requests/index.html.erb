<%# console.export-personal-data / .erase-personal-data — a P-LIST over
    Identity::DataRequest, rendered through the shared list partial: the cb column, the
    three core bulk actions (Resend confirmation requests / Mark requests as completed /
    Delete requests), the get_views() status tabs and the Search Requests box all come
    from @requests_table (Console::ListModel). Columns LITERAL
    (class-wp-privacy-requests-table.php:43-46). -%>
<% export = @kind == "export" %>
<% @page_title = (export ? "Export Personal Data" : "Erase Personal Data") %>

<%# export-personal-data.php:107-110 / erase-personal-data.php — the intro copy, LITERAL. -%>
<p><%= export ?
       "This tool helps site owners comply with local laws and regulations by exporting known data for a given user in a .zip file." :
       "This tool helps site owners comply with local laws and regulations by deleting or anonymizing known data for a given user." %></p>

<%= render "console/shared/list", list: @requests_table %>

<hr>

<%# export-personal-data.php:113-142 — the "Add Data Export/Erasure Request" form. The
    "Send … confirmation email" checkbox is checked by default; unchecking it creates the
    request directly `confirmed` instead of sending a confirmation email (privacy-tools.php
    :116-118). Strings LITERAL. -%>
<h2><%= export ? "Add Data Export Request" : "Add Data Erasure Request" %></h2>
<%= form_with url: path_for(@kind == "export" ? "export" : "erasure"), method: :post, data: { turbo: false } do %>
  <input type="hidden" name="kind" value="<%= @kind %>">
  <table class="form-table">
    <tr>
      <th scope="row">
        <label for="username_or_email_for_privacy_request">Username or email address</label>
      </th>
      <td>
        <input type="text" name="username_or_email" id="username_or_email_for_privacy_request" class="regular-text ltr" required>
      </td>
    </tr>
    <tr>
      <th scope="row">Confirmation email</th>
      <td>
        <input type="checkbox" name="send_confirmation_email" id="send_confirmation_email" value="1" checked>
        <label for="send_confirmation_email"><%= export ?
          "Send personal data export confirmation email." :
          "Send personal data erasure confirmation email." %></label>
      </td>
    </tr>
  </table>
  <p class="submit">
    <button type="submit" class="button button-primary">Send Request</button>
  </p>
<% end %>
