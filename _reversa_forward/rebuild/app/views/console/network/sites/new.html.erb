<%# console.ms-site-new — wp-admin/network/site-new.php:192-300, modernized. Every label,
    description and error is VERBATIM from the PHP. -%>
<h1 id="add-new-site">Add Site</h1>
<hr class="wp-header-end">
<%= render "console/network/nav" %>

<% if @errors.any? %>
  <div class="notice notice-error" role="alert">
    <% @errors.each do |message| %><p><%= message %></p><% end %>
  </div>
<% end %>

<%= form_with url: "/console/network/sites", method: :post, data: { turbo: false } do %>
  <table class="form-table" role="presentation">
    <tbody>
      <tr class="form-field form-required">
        <th scope="row"><label for="site-address">Site Address (URL)</label></th>
        <td>
          <input name="blog[domain]" type="text" class="regular-text code" id="site-address"
                 aria-describedby="site-address-desc" autocapitalize="none" autocorrect="off"
                 value="<%= @form["domain"] %>" required>
          <p class="description" id="site-address-desc">Only lowercase letters (a-z), numbers, and hyphens are allowed.</p>
        </td>
      </tr>
      <tr class="form-field form-required">
        <th scope="row"><label for="site-title">Site Title</label></th>
        <td><input name="blog[title]" type="text" class="regular-text" id="site-title" value="<%= @form["title"] %>" required></td>
      </tr>
      <tr class="form-field form-required">
        <th scope="row"><label for="admin-email">Admin Email</label></th>
        <td>
          <input name="blog[email]" type="email" class="regular-text" id="admin-email"
                 aria-describedby="site-admin-email" value="<%= @form["email"] %>" required>
          <p class="description" id="site-admin-email">A new user will be created if the above email address is not in the database.<br>The username and a link to set the password will be mailed to this email address.</p>
        </td>
      </tr>
    </tbody>
  </table>
  <p class="submit"><button type="submit" class="button button-primary" id="add-site">Add Site</button></p>
<% end %>
