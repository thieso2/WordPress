<%# console.comment — the Reply row action (class-wp-comments-list-table.php:871). The
    legacy expands wp_comment_reply()'s inline form; modernized as a page over the same
    comment textarea. FUNCTIONAL strings ("Comment", "Reply", "Cancel") are LITERAL. %>
<h1><%= @page_title %></h1>

<p class="reply-context">
  <%= "In response to" %>:
  <strong><%= @parent.author_name.presence || "Anonymous" %></strong>
  — <%= truncate(@parent.content.to_s, length: 120) %>
</p>

<%= form_with url: reply_console_comment_path(@parent), method: :post, local: true do %>
  <div class="panel" id="replydiv">
    <label for="content"><%= "Comment" %></label>
    <textarea name="content" id="content" rows="8"><%= @reply&.content %></textarea>
  </div>

  <div class="submit">
    <button type="submit" name="save" class="button button-primary"><%= "Reply" %></button>
    <a class="button button-link" href="/console/comments"><%= "Cancel" %></a>
  </div>
<% end %>
