<%# DEV-004 — the interstitial confirmation a destructive bulk action gets before it
    runs. The legacy deletes without one (class-wp-list-table.php); this is the approved,
    contained safety improvement. The action label and the item descriptions are LITERAL /
    the records' own titles. Re-posts the same bulk request with confirmed=1. -%>
<h1 class="wp-heading-inline"><%= @confirm_title %></h1>
<hr class="wp-header-end">
<div class="confirm-box notice notice-error">
  <p><%= @confirm_prompt %></p>
  <% if @confirm_items.present? %>
    <ul>
      <% @confirm_items.each do |label| %>
        <li><%= label %></li>
      <% end %>
    </ul>
  <% end %>
  <%= form_with url: @confirm_path, method: :post, data: { turbo: false } do %>
    <%= hidden_field_tag :bulk_action, @confirm_action %>
    <%= hidden_field_tag :confirmed, "1" %>
    <% Array(@confirm_ids).each do |id| %>
      <%= hidden_field_tag "ids[]", id %>
    <% end %>
    <button type="submit" class="button button-primary"><%= @confirm_button %></button>
    <%= link_to "Cancel", @confirm_cancel_path, class: "button" %>
  <% end %>
</div>
