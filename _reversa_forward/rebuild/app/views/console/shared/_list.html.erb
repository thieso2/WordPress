<%# P-LIST — the one shared rendering of every filtered, paginated, bulk-actionable list
    (target_screens.md § Part 1). Driven entirely by a Console::ListModel the controller
    built; this partial adds no data and asks Access nothing (the controller resolved every
    policy question already, BR-CAP-05). LITERAL strings — title, column headers, tab
    labels, bulk-action labels, empty-state — arrive verbatim and are printed as given.

    The INFORMATION ARCHITECTURE follows WP_List_Table (owner ruling, 2026-08-24): heading
    + Add New action, the status tabs, the search box, then tablenav/table/tablenav with
    the tablenav REPEATED below the table and the column headers repeated in <tfoot>. The
    styling is the rebuild's own and is scoped here so the list renders the same under any
    console layout revision. -%>
<% list = local_assigns.fetch(:list) %>
<% headings = list_headings(list) %>
<% search = list.filters.find { |flt| flt.kind == :search } %>
<% filter_form_id = list_filter_form_id(list) %>
<% bulk_form_id = "#{list.screen.tr('.', '-')}-bulk" %>
<style>
  /* Layout-only rules for the list table. Everything visual — palette, type, metrics —
     comes from the wp-admin skin in the console layout (DEV-014); duplicating it here is
     what made .row-actions and .subsubsub render at .85rem (13.6px) instead of the
     oracle's 13px. What remains is structure the skin does not describe. */
  .wp-list-table th.sortable a, .wp-list-table th.sorted a { text-decoration: none; color: inherit; display: inline-flex; align-items: center; gap: .25rem; }
  .wp-list-table th.sorted { color: var(--wp-heading, #1d2327); }
  .sorting-indicators { display: inline-flex; flex-direction: column; line-height: .6; }
  .sorting-indicator { border: 4px solid transparent; }
  .sorting-indicator.asc { border-bottom-color: var(--wp-rule, #a7aaad); }
  .sorting-indicator.desc { border-top-color: var(--wp-rule, #a7aaad); }
  th.sorted.asc .sorting-indicator.asc { border-bottom-color: var(--wp-accent, #3858E9); }
  th.sorted.desc .sorting-indicator.desc { border-top-color: var(--wp-accent, #3858E9); }
  .row-actions form { display: inline; margin: 0; }
  .row-actions a, .row-actions button.button-link { color: var(--wp-accent, #3858E9); background: none; border: 0; padding: 0; cursor: pointer; font: inherit; }
  .row-actions .destructive a, .row-actions .destructive button { color: #b32d2e; }
  .subsubsub li { display: inline; }
  .subsubsub a { text-decoration: none; }
  .subsubsub a.current { font-weight: 600; color: var(--wp-heading, #1d2327); }
  .tablenav .actions { display: flex; gap: .35rem; align-items: center; }
  .tablenav .actions:empty, .tablenav .actions.hidden { display: none; }
  .tablenav-pages { margin-left: auto; display: flex; align-items: center; gap: .4rem; }
  .tablenav-pages .pagination-links { display: flex; align-items: center; gap: .2rem; }
  .tablenav-pages .paging-input { display: inline-flex; align-items: center; gap: .25rem; }
  .tablenav-pages .current-page { width: 3em; }
  .list-filter-form { display: contents; }
  .search-box { display: flex; gap: .35rem; justify-content: flex-end; }
  .table-scroll { overflow-x: auto; }
</style>

<%# edit.php:414-436 — the <h1>, the "Add New" button as its SIBLING (page-title-action),
    the search subtitle, then the <hr class="wp-header-end"> the notices anchor to. %>
<h1 class="wp-heading-inline"><%= list.title %></h1>
<% if list.primary_action %>
  <%= link_to list.primary_action[:label], list.primary_action[:path], class: "page-title-action" %>
<% end %>
<% if list.search_query.present? %>
  <span class="subtitle"><%# edit.php:427 — "Search results for: %s" %>Search results for: <strong><%= list.search_query %></strong></span>
<% end %>
<hr class="wp-header-end">

<%# views() — WP_List_Table::get_views, "All | Published | Draft | Trash", preceded by its
    screen-reader heading and sitting ABOVE the search box (edit.php:486-490). The label
    markup (e.g. 'All <span class="count">(3)</span>') is LITERAL and already escaped. %>
<% if list.tabs? %>
  <h2 class="screen-reader-text"><%= headings[:views] %></h2>
  <ul class="subsubsub">
    <% list.tabs.each_with_index do |tab, i| %>
      <li class="<%= tab.key %>">
        <%= link_to list_url(list, tab.query), class: (tab.current? ? "current" : nil),
                    "aria-current": (tab.current? ? "page" : nil) do %><%= raw tab.label %><% end %><%= " |" unless i == list.tabs.length - 1 %>
      </li>
    <% end %>
  </ul>
<% end %>

<%# The screen's GET form. It carries every list control that is a QUERY (search, the
    months/category selects, the pager's Current Page input); those controls live inside
    the tablenav below and bind here through their `form` attribute, because the bulk form
    that wraps the table POSTs and a nested <form> is dropped by the HTML parser. %>
<form id="<%= filter_form_id %>" class="list-filter-form" method="get" action="<%= list.base_path %>" data-turbo="false">
  <% list_filter_carry(list).each do |key, value| %>
    <input type="hidden" name="<%= key %>" value="<%= value %>">
  <% end %>
</form>

<%# search_box( $text, $input_id ) — class-wp-list-table.php:1417. Hidden <label>, the
    screen's OWN search text on the submit button ("Search Posts", "Search Users"…), and a
    per-screen input id. Suppressed on an empty, unsearched list, as the legacy does. %>
<% if search && (search.value.present? || list.any_rows?) %>
  <p class="search-box">
    <label class="screen-reader-text" for="<%= list_search_input_id(list) %>"><%= search.label %>:</label>
    <input type="search" id="<%= list_search_input_id(list) %>" name="s" value="<%= search.value %>" form="<%= filter_form_id %>">
    <button type="submit" id="search-submit" class="button" form="<%= filter_form_id %>"><%= search.label %></button>
  </p>
<% end %>

<%= form_with url: list.bulk_path, method: :post, id: bulk_form_id, class: "list-bulk-form", data: { turbo: false } do |f| %>
  <%= render "console/shared/tablenav", list: list, which: "top" %>

  <%# display() renders the screen-reader heading for the table between the top tablenav
      and the table itself (class-wp-list-table.php:1521). %>
  <h2 class="screen-reader-text"><%= headings[:list] %></h2>
  <div class="table-scroll">
    <table class="wp-list-table widefat fixed striped">
      <thead>
        <tr><%= render "console/shared/list_headers", list: list, with_id: true, cb_id: "cb-select-all-1" %></tr>
      </thead>
      <tbody id="the-list">
        <% if list.any_rows? %>
          <% list.rows.each do |row| %>
            <tr id="<%= list.screen %>-<%= row.id %>">
              <% if list.bulk_actions? %>
                <th scope="row" class="check-column">
                  <% if row.selectable? %>
                    <input type="checkbox" name="ids[]" value="<%= row.id %>">
                  <% end %>
                </th>
              <% end %>
              <% list.columns.each_with_index do |col, i| %>
                <% primary = i.zero? %>
                <td class="column-<%= col.key %><%= " column-primary" if primary %><%= " has-row-actions" if primary && row.actions.present? %>">
                  <%= raw row.cell(col.key) %>
                  <%# row_actions() — class-wp-list-table.php:582: one .row-actions
                      container inside the PRIMARY column, each action in its own span,
                      separated by " | " except after the last. %>
                  <% if primary && row.actions.present? %>
                    <div class="row-actions">
                      <% row.actions.each_with_index do |ra, j| %>
                        <span class="<%= 'destructive' if ra.destructive? %> <%= ra.key %>"><% if ra.get? %><%= link_to ra.label, ra.path %><% else %><%= button_to ra.label, ra.path, method: ra.http_method,
                                        params: ra.parameters, form_class: "button-link-form",
                                        class: "button-link", data: { turbo: false } %><% end %><%= " | " unless j == row.actions.length - 1 %></span>
                      <% end %>
                    </div>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        <% else %>
          <tr class="no-items">
            <td colspan="<%= list.columns.length + (list.bulk_actions? ? 1 : 0) %>"><%= list.empty_message %></td>
          </tr>
        <% end %>
      </tbody>
      <%# display() repeats the column headers in the footer with print_column_headers(
          false ) — same labels and sort links, no ids, its own Select All checkbox. %>
      <tfoot>
        <tr><%= render "console/shared/list_headers", list: list, with_id: false, cb_id: "cb-select-all-2" %></tr>
      </tfoot>
    </table>
  </div>

  <%# display_tablenav( 'bottom' ) returns early when the list has no rows. %>
  <% if list.any_rows? %>
    <%= render "console/shared/tablenav", list: list, which: "bottom" %>
  <% end %>
<% end %>

<script>
  (function () {
    var form = document.getElementById(<%= bulk_form_id.to_json.html_safe %>);
    if (!form) return;

    // Both Select All checkboxes (thead and tfoot) drive the row checkboxes and each other.
    var all = form.querySelectorAll("input.cb-select-all");
    all.forEach(function (master) {
      master.addEventListener("click", function () {
        form.querySelectorAll('input[name="ids[]"]').forEach(function (cb) { cb.checked = master.checked; });
        all.forEach(function (other) { other.checked = master.checked; });
      });
    });

    // current_action() (class-wp-list-table.php:1084): the TOP select wins when it names an
    // action, otherwise the bottom one does. Both carry the same name, so the loser is
    // disabled on submit and never reaches the server.
    form.addEventListener("submit", function () {
      var top = form.querySelector("#bulk-action-selector-top");
      var bottom = form.querySelector("#bulk-action-selector-bottom");
      if (!top || !bottom) return;
      top.disabled = false;
      bottom.disabled = false;
      if (top.value !== "-1") { bottom.disabled = true; } else { top.disabled = true; }
    });
  })();
</script>
