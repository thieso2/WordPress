<%# console.site-health-info — site-health-info.php, modernized. h1 LITERAL. -%>
<% @page_title = "Site Health Info" %>
<h1 class="wp-heading-inline">Site Health Info</h1>
<hr class="wp-header-end">
<nav class="health-check-tabs" aria-label="Secondary menu">
  <%= link_to "Status", "/console/tools/site-health" %>
  <%= link_to "Info", "/console/tools/site-health/info", class: "current" %>
</nav>
<hr class="wp-header-end">

<%# site-health-info.php:57-59 — the intro paragraph describing the export button, LITERAL. -%>
<p><%= "If you want to export a handy list of all the information on this page, you can use the button below to copy it to the clipboard. You can then paste it in a text file and save it to your device, or paste it in an email exchange with a support engineer or theme/plugin developer for example." %></p>

<%# site-health-info.php:61-70 — WP_Debug_Data::format( $info, 'debug' ) is a plain-text
    dump of every section/field; reproduced here from @info so the copy button carries the
    same handy export. The button label / "Copied!" confirmation are LITERAL. -%>
<% clipboard_text = @info.map { |section, rows|
     ["### #{section} ###", *rows.map { |label, value| "#{label}: #{value}" }, ""].join("\n")
   }.join("\n") %>
<div class="site-health-copy-buttons">
  <div class="copy-button-wrapper">
    <button type="button" class="button copy-button" data-clipboard-text="<%= clipboard_text %>"
            onclick="navigator.clipboard&&navigator.clipboard.writeText(this.getAttribute('data-clipboard-text'));this.nextElementSibling.classList.remove('hidden');">
      <%= "Copy site info to clipboard" %>
    </button>
    <span class="success hidden" aria-hidden="true"><%= "Copied!" %></span>
  </div>
</div>

<% @info.each do |section, rows| %>
  <h2><%= section %></h2>
  <table class="widefat">
    <tbody>
      <% rows.each do |label, value| %>
        <tr><th scope="row"><%= label %></th><td><%= value %></td></tr>
      <% end %>
    </tbody>
  </table>
<% end %>
