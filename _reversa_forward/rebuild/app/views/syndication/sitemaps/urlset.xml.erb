<% links = Composition::Renderers::PostBlocks::Links -%>
<% home = Composition::Renderers::PostBlocks::Site.home_url -%>
<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="<%== home %>/wp-sitemap.xsl" ?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"><% if @home_entry %><url><loc><%== @home_entry[:loc] %></loc><% if @home_entry[:lastmod] %><lastmod><%== @home_entry[:lastmod].utc.strftime("%Y-%m-%dT%H:%M:%S+00:00") %></lastmod><% end %></url><% end %><% @entries.each do |entry| %><url><loc><%== links.permalink(entry) %></loc><lastmod><%== entry.modified_at.utc.strftime("%Y-%m-%dT%H:%M:%S+00:00") %></lastmod></url><% end %></urlset>