<%#-
  Byte-level transcription of wp-includes/feed-atom.php against the captured golden.
  The entry <id> is the_guid() (feed-atom.php:79) — a UUID here by design (T-07 /
  BR-POST-10), normalized by the harness.
-%><% t = Syndication::FeedText -%>
<% links = Composition::Renderers::PostBlocks::Links -%>
<% home = Composition::Renderers::PostBlocks::Site.home_url -%>
<?xml version="1.0" encoding="UTF-8"?><feed
	xmlns="http://www.w3.org/2005/Atom"
	xmlns:thr="http://purl.org/syndication/thread/1.0"
	xml:lang="en-US"
	>
	<title type="text"><%== t.wp_title_rss %></title>
	<subtitle type="text"><%== t.bloginfo_rss(Configuration::Setting.display("blogdescription")) %></subtitle>

	<updated><%== t.atom_time(@build_date) %></updated>

	<link rel="alternate" type="text/html" href="<%== home %>" />
	<id><%== home %>/feed/atom/</id>
	<link rel="self" type="application/atom+xml" href="<%== home %>/feed/atom/" />

	<generator uri="https://wordpress.org/" version="7.2-alpha-63330">WordPress</generator>
<% @posts.each_with_index do |post, i| -%>
<% ctx = Composition::RenderContext.new(post: post) -%>
<% n = @comment_counts.fetch(post.id, 0) -%>
<% permalink = links.permalink(post) -%>
<%== i.zero? ? "\t" : "\t\t" %><entry>
		<author>
			<name><%== post.author&.display_name %></name>
<% if post.author&.url.present? -%>
							<uri><%== post.author.url %></uri>
<% end -%>
						</author>

		<title type="html"><![CDATA[<%== t.the_title_rss(post) %>]]></title>
		<link rel="alternate" type="text/html" href="<%== permalink %>" />

		<id><%== post.guid %></id>
		<updated><%== t.atom_time(post.modified_at) %></updated>
		<published><%== t.atom_time(post.published_at) %></published>
		<%== t.category_rss(post, "atom") %>
		<summary type="html"><![CDATA[<%== t.the_excerpt_rss(post, ctx) %>]]></summary>

					<content type="html" xml:base="<%== permalink %>"><![CDATA[<%== t.the_content_feed(post, ctx) %>]]></content>
		<%= "" %>
<% if n.positive? || post.comment_status.to_s == "open" -%>
					<link rel="replies" type="text/html" href="<%== permalink %>#comments" thr:count="<%== n %>" />
			<link rel="replies" type="application/atom+xml" href="<%== permalink %>feed/atom/" thr:count="<%== n %>" />
			<thr:total><%== n %></thr:total>
<% end -%>
			</entry>
<% end -%>
	</feed>