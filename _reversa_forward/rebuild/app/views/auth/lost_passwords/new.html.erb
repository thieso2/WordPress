<%# auth.lostpassword -- wp-login.php:864-899 (the `lostpasswordform`). -%>
<% @title = "Lost Password"; @legacy_action = "lostpassword"; @screen = "auth.lostpassword" %>
<% content_for :message do %>
  <%# :866-872: the help text is a `message` notice above the errors. %>
  <div class="notice notice-info message"><p>Please enter your username or email address. You will receive an email message with instructions on how to reset your password.</p></div>
<% end %>
<%= form_with url: lost_password_path, method: :post, id: "lostpasswordform", html: { name: "lostpasswordform" } do |f| %>
  <p>
    <label for="user_login">Username or Email Address</label>
    <input type="text" name="user_login" id="user_login" class="input ltr" value="<%= @user_login %>" size="20" autocapitalize="off" autocomplete="username" required="required" autofocus>
  </p>
  <input type="hidden" name="redirect_to" value="<%= @redirect_to %>">
  <p class="submit">
    <input type="submit" name="wp-submit" id="wp-submit" class="button button-primary button-large" value="Get New Password" data-disable-with="Get New Password">
  </p>
<% end %>
<%# :880-896: "Log in", then Register when open. %>
<%= render "auth/shared/nav", links: %i[login register] %>
